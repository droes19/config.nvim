{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "cyan",
          "properties": {
            "linux": "\ue712",
            "macos": "\ue711",
            "windows": "\ue70f"
          },
          "style": "plain",
          "template": "  {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "foreground": "#007ACC",
          "properties": {
            "time_format": "Monday, _2-Jan-2006, 15:04:05"
          },
          "style": "plain",
          "template": " {{ .CurrentDate | date .Format }} ",
          "type": "time"
        },
        {
          "foreground": "#ce092f",
          "style": "plain",
          "template": " {{ if .Error }}{{ .Error }}{{ else }} {{ .Full }}{{ end }} ",
          "type": "angular"
        },
        {
          "foreground": "white",
          "style": "plain",
          "template": " {{ if .Error }}{{ .Error }}{{ else }} {{ .Full }}{{ end }} ",
          "type": "lua"
        },
        {
          "foreground": "#3C873A",
          "properties": {
            "fetch_package_manager": true,
            "npm_icon": "<#e5272d>\ue616</>",
            "yarn_icon": "<#37aee5>\ue6a7</>",
            "pnpm_icon": "<#e5a100>\udb80\udec1</>",
            "bun_icon": "<#37aee5>\ue76f</>"
          },
          "style": "plain",
          "template": " {{ if glob \"angular.json\" }}{{ else }}{{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}{{ end }} ",
          "type": "node"
        },
        {
          "foreground": "#ec2729",
          "style": "plain",
          "template": " {{ if .Error }}{{ .Error }}{{ else }} {{ .Full }}{{ end }} ",
          "type": "java"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "lightBlue",
          "style": "plain",
          "template": "# ",
          "type": "text"
        },
        {
          "foreground": "red",
          "style": "plain",
          "template": " % ",
          "type": "root"
        },
        {
          "style": "plain",
          "template": "<cyan>{{ .UserName }}</><darkGray>@</><green>{{ .HostName }}</> ",
          "type": "session"
        },
        {
          "foreground": "lightYellow",
          "properties": {
            "style": "full"
          },
          "style": "plain",
          "template": "<darkGray>in </>{{ .Path }} ",
          "type": "path"
        },
        {
          "type": "git",
          "style": "plain",
          "template": "<white>git:</><cyan>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uF044 {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uF046 {{ .Staging.String }}{{ end }}</>",
          "properties": {
            "fetch_status": true
          }
        },
        {
          "foreground": "red",
          "style": "plain",
          "template": " C:{{ if gt .Code 0 }}{{ .Code }}{{ end }} ",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "#a9ffb4",
          "properties": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "plain",
          "template": " {{ .FormattedMs }} <#ffffff>\ue601</>",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#cd5e42",
          "style": "plain",
          "template": "\ue3bf ",
          "type": "root"
        },
        {
          "foreground": "lightRed",
          "style": "plain",
          "template": "$",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}
